# Copy to config.env and fill in (config.env is gitignored).
# Usage:  .\scripts\deploy\deploy-all.ps1

# --- Frontend (Vercel) ---
# Production site (health check after deploy)
FRONTEND_HEALTH_URL=https://coninter-main.vercel.app/
# Baked into static build / Vercel env — browser calls this host for /api
NEXT_PUBLIC_BACKEND_API_URL=https://connitor.bengalurutechcommunity.com
# Optional: deploy-frontend.ps1 -UseGitPush uses this remote/branch
VERCEL_GIT_REMOTE=coninter
VERCEL_GIT_BRANCH=main

# --- Backend (EC2) ---
EC2_HOST=connitor.bengalurutechcommunity.com
EC2_USER=ubuntu
EC2_SSH_KEY=C:\Users\Ditto\.ssh\connitor-ec2-clean.pem
EC2_PPK_KEY=C:\Users\Ditto\Downloads\connitor.ppk
EC2_REMOTE_DIR=/home/ubuntu/connitor/connitor
EC2_DEPLOY_METHOD=rsync
EC2_GIT_BRANCH=main
EC2_SYSTEMD_SERVICE=conni
EC2_VENV_DIR=conni
EC2_MIGRATE_SCRIPTS=migrate_visit_slot_allotment.py,migrate_livekit_meetings.py

BACKEND_HEALTH_URL=https://connitor.bengalurutechcommunity.com/
