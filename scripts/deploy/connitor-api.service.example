[Unit]
Description=Connitor FastAPI (Hospital Visitor Tracking)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/connitor/python_backend
Environment=PYTHONPATH=/home/ubuntu/connitor/python_backend
EnvironmentFile=-/home/ubuntu/connitor/python_backend/.env
ExecStart=/home/ubuntu/connitor/python_backend/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
